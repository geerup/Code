# .env.example — homelab compose stack
#
# Copy to .env and replace every value with your own. NEVER commit the real .env.
# Placeholder values only below. Real secrets, real overlay addresses, real domains,
# and real tokens must stay off the public repo.

# --- Overlay bind ---------------------------------------------------------------
# The host's address ON the WireGuard/Tailscale overlay interface. Every service
# publishes ONLY to this address. Never 0.0.0.0, never a WAN/LAN-routable address
# you would forward from the internet. Example uses an RFC1918 placeholder.
OVERLAY_BIND_ADDR=10.0.0.2

# --- Forgejo (git forge) --------------------------------------------------------
FORGEJO_DOMAIN=forge.example.internal
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# --- act_runner (CI executor) ---------------------------------------------------
# Reaches Forgejo over the overlay. Registration token is a SECRET.
FORGEJO_INSTANCE_URL=http://forge.example.internal:3000
ACT_RUNNER_TOKEN=replace-with-one-time-registration-token
ACT_RUNNER_NAME=act-runner-01
ACT_RUNNER_LABELS=docker:docker://node:20-bookworm

# --- Vaultwarden (secrets manager) ----------------------------------------------
# Admin token is a SECRET (store the Argon2 PHC hash, not a plaintext token).
VAULTWARDEN_DOMAIN=vault.example.internal
VAULTWARDEN_HTTP_PORT=8000
VAULTWARDEN_ADMIN_TOKEN=replace-with-argon2-phc-hash

# --- code-server ----------------------------------------------------------------
CODE_SERVER_HTTP_PORT=8443
CODE_SERVER_PASSWORD=replace-with-strong-password
CODE_SERVER_SUDO_PASSWORD=replace-with-strong-password

# --- Dozzle (log viewer) --------------------------------------------------------
DOZZLE_HTTP_PORT=8888
# Path on the host to the Dozzle simple-auth users file (bind-mounted read-only).
DOZZLE_USERS_FILE=./dozzle/users.yml

# --- Uptime Kuma (status dashboard) ---------------------------------------------
UPTIME_KUMA_HTTP_PORT=3001
