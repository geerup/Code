# restic backup configuration.
#
# Install to /etc/restic-backup/restic.env (chmod 600, root-owned). The scripts
# and systemd unit read it via RESTIC_BACKUP_CONFIG (default that path).
# This file is an EXAMPLE — placeholder values only, never commit real ones.

# --- repository (pick ONE backend) ------------------------------------------
# Local / external disk:
RESTIC_REPOSITORY=/srv/backups/restic-repo
# SFTP:  RESTIC_REPOSITORY=sftp:backup-user@backup.example.internal:/srv/restic-repo
# B2:    RESTIC_REPOSITORY=b2:example-bucket-name:host/path

# Encryption passphrase is read from this root-only file (NOT stored here).
# Create it with:  umask 077; printf '%s' 'your-passphrase' > /etc/restic-backup/password
RESTIC_PASSWORD_FILE=/etc/restic-backup/password

# --- what to back up --------------------------------------------------------
# Space-separated list of roots. Paths with spaces are not supported by design.
BACKUP_PATHS=/etc /home /srv

# Optional exclude file (one pattern per line).
EXCLUDE_FILE=/etc/restic-backup/excludes.txt

# --- retention (forget --prune) ---------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Tag applied to snapshots and used to scope the retention policy.
BACKUP_TAG=scheduled

# --- backend credentials (only if the chosen backend needs them) ------------
# Backblaze B2 example — placeholders, supply real values here, never in git:
# B2_ACCOUNT_ID=example-account-id
# B2_ACCOUNT_KEY=example-application-key
