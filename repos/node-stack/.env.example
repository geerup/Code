# .env.example — placeholder values only. Copy to .env, fill in real values,
# and never commit .env (it's gitignored).

# Bitcoin Core RPC credentials — used by both bitcoind and Fulcrum.
BITCOIN_RPC_USER=changeme_rpc_user
BITCOIN_RPC_PASSWORD=changeme_rpc_password_use_a_long_random_value

# Bitcoin Core UTXO cache size in MB — see docs/capacity-analysis.md before
# raising this; it's the primary RAM knob for bitcoind.
BITCOIN_DBCACHE_MB=450

# Fulcrum DB memory budget in MB — separate working set from bitcoind's
# dbcache, see docs/capacity-analysis.md.
FULCRUM_DB_MEM_MB=2000

# Monero RPC login (user:password format expected by monerod --rpc-login).
MONERO_RPC_LOGIN=changeme_rpc_user:changeme_rpc_password
