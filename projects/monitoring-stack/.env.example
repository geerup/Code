# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Overlay address this stack binds published ports to (WireGuard/overlay IP of
# this host). 127.0.0.1 keeps everything host-local until you set it.
BIND_ADDR=127.0.0.1

# Grafana initial admin credentials. Change the password before first deploy;
# rotate it in the Grafana UI afterward. These placeholders are not real creds.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy
