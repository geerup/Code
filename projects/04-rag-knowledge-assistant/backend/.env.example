# Copy to .env and adjust. Defaults run fully offline via the "fake" providers.

# Storage
RAG_DB_PATH=rag.db

# Chunking / retrieval
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# Providers: "ollama" (default) or "fake" (offline, deterministic)
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

# Ollama connection (run `ollama serve` and `ollama pull llama3.2 nomic-embed-text`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# CORS: "*" or comma-separated origins (set to your Vercel URL in production)
RAG_CORS_ORIGINS=*
